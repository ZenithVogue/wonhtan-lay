# Copy to .env.local and fill in the keys. Never commit .env.local.
#
# Supabase (Project Settings → API in the Supabase dashboard).
# The server routes read SUPABASE_URL / SUPABASE_ANON_KEY (falling back to the
# NEXT_PUBLIC_* pair). The dashboard's realtime subscription runs in the
# browser, so it needs the NEXT_PUBLIC_* pair — set both to the same values.
SUPABASE_URL=https://pfwoatbmdhwhaosnuwcj.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_URL=https://pfwoatbmdhwhaosnuwcj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Optional: Telegram bot token from @BotFather. When set, the server starts
# polling Telegram for new messages automatically on boot (no public URL
# needed). You can also connect from Dashboard → Bot Connections instead.
TELEGRAM_BOT_TOKEN=
